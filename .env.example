# Base URL of the Facet API, including the /api prefix
VITE_API_URL=http://localhost:4000/api
# Sent as the `app-source` header on every request
VITE_APP_SOURCE=web
# Optional: socket server for live upload previews (defaults to the API host)
VITE_SOCKET_URL=
# Currency label shown next to prices (must match what the payment gateway charges)
VITE_CURRENCY=QAR
